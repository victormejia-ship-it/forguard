rules_version = '2';

/* ===========================================================================
   Reglas de seguridad de Firebase Storage — Control de Forpass / Forguard

   Aquí viven las fotos de evidencia de los servicios de póliza (ver
   subirEvidenciaStorage() en index.html): antes se guardaban completas
   (base64) DENTRO del documento de Firestore, y una póliza con años de
   servicio terminó pasándose del 1 MiB que Firestore permite por documento
   (POL-024, sep-2026). Ahora la foto vive aquí y el documento solo guarda
   la URL de descarga.

   Mismo criterio de acceso que config/firestore.rules —de hecho, ESTAS
   reglas consultan Firestore (firestore.get()/firestore.exists()) para
   saber el rol de quien pide algo, así nunca hay dos definiciones de "quién
   puede qué" que se puedan desalinear.

   Cómo se pegan: consola de Firebase → Storage → pestaña Reglas → borra lo
   que haya, pega todo esto, y dale a Publicar.
   =========================================================================== */

service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }
    function conAcceso() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }
    function rol() { return perfil().rol; }

    /* Mismo candado que puedeRegistrarServicioPoliza() en index.html: quien
       puede editar en general, más el técnico de piso que es quien de
       verdad está frente al equipo tomando la foto. */
    function puedeRegistrarServicio() {
      return conAcceso() && rol() in ['owner', 'admin', 'analyst', 'tecnico'];
    }

    /* --- Evidencias de servicios de póliza --- */
    match /evidencias/polizas/{polizaId}/{archivo} {
      /* Leer (mostrar la foto ya subida): cualquiera con acceso interno.
         El portal de clientes NUNCA llega aquí — vistaPortalPolizas() no
         pinta evidencias, y su copia en /polizas_cliente ya viene sin ellas
         (ver datosClientePoliza()). */
      allow read: if conAcceso();
      /* Subir una foto nueva: solo quien puede registrar el servicio, y con
         un tope de tamaño/tipo de archivo — la compresión de comprimirEvidencia()
         ya la deja muy por debajo de esto; el tope es solo un cinturón. */
      allow write: if puedeRegistrarServicio()
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if puedeRegistrarServicio();
    }

    /* --- Evidencias de reportes de mantenimiento (agregado 10-sep-2026) ---
       Mismo candado que /reportes en firestore.rules: capturar y corregir,
       cualquiera con acceso que no sea cliente (create/update ahí es
       "conAcceso() && !esCliente()"). A diferencia de pólizas, el portal de
       cliente SÍ enseña estas fotos (vistaPortalReporte() las pinta
       directo) — pero eso no depende de esta regla: el <img> del navegador
       pide la URL con el downloadToken ya incluido, sin mandar el token de
       Firebase Auth, y Storage sirve el archivo con solo ese token válido
       sin evaluar esta regla. "allow read" aquí protege nada más contra
       quien intente leer por otra vía (el SDK, gsutil) sin ese token. */
    match /evidencias/reportes/{reporteId}/{archivo} {
      allow read: if conAcceso();
      /* Segunda cláusula, agregada 11-sep-2026: el formulario público de
         reportes (ver enlaces_publicos_reportes/ en firestore.rules) sube
         sus fotos con Firebase Auth ANÓNIMO, que nunca pasa conAcceso()
         (no tiene ficha en /usuarios). Storage no puede cruzar aquí el
         mismo candado que sí aplica firestore.rules al CREAR el reporte
         (que el token venga de un link activo del mismo cliente): esa
         validación completa ya la hizo Firestore al aceptar el documento,
         y esta ruta ni siquiera sabe a qué reporte pertenece la foto hasta
         que ese create ya pasó. Lo que sí se puede exigir aquí —tamaño y
         tipo de archivo— es EXACTAMENTE lo mismo que ya exige la primera
         cláusula. */
      allow write: if ((conAcceso() && rol() != 'cliente') || request.auth != null)
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if conAcceso() && rol() != 'cliente';
    }

    /* --- Imágenes/PDFs de proyectos de Imagen/Aperturas (agregado
           21-sep-2026) ---
       Mismo problema que ya resolvió /evidencias/polizas y /evidencias/reportes:
       hasta ahora, renders/planos/fotos de un proyecto se guardaban completos
       en base64 DENTRO del documento de Firestore, con un presupuesto
       compartido de 800 KB entre los 12 archivos posibles — el mismo síntoma
       exacto que ya tronó a POL-024 (el veredicto de auditoría, 21-sep-2026,
       lo marca como hallazgo de Escala: "Tope de 1 MB por registro"). Ahora
       cada archivo vive aquí y el documento solo guarda la URL.

       Mismo candado que /proyectosImagen en firestore.rules: leer y escribir,
       cualquiera con acceso que pueda editar precios (puedeEditar()) — el
       portal de clientes NUNCA llega aquí, proyectosImagen está cerrado por
       completo para ese rol. A diferencia de /evidencias/reportes, no hace
       falta una segunda cláusula para Auth anónimo: no existe ningún
       formulario público que suba a esta carpeta. Acepta imágenes Y PDF
       (a diferencia de las otras dos, aquí un plano puede quedarse como PDF
       de verdad si la conversión a imagen falla — ver convertirPdfAImagen()/
       el catch de agregarImagenPISiCabe en index.html). */
    match /evidencias/proyectosImagen/{proyectoId}/{archivo} {
      allow read: if conAcceso() && rol() != 'cliente';
      allow write: if conAcceso() && rol() in ['owner', 'admin', 'analyst']
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if conAcceso() && rol() in ['owner', 'admin', 'analyst'];
    }

    /* Candado general: cualquier ruta que no se haya marcado explícito
       arriba queda cerrada. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
