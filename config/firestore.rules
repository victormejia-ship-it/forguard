rules_version = '2';

/* ===========================================================================
   Reglas de seguridad de Control de Forpass

   Esto es lo que de verdad protege la información: aunque alguien copie la
   página o los datos de configuración, sin una cuenta con permiso concedido
   aquí no puede leer ni escribir nada.

   Cómo se pegan: consola de Firebase → Firestore Database → pestaña Reglas →
   borra lo que haya, pega todo esto, y dale a Publicar.

   Permisos:
     owner    → todo, y es el único que puede nombrar o tocar a otro owner
     admin    → todo lo demás, incluido administrar cuentas
     analyst  → agrega y modifica clientes, sitios y pagos
     viewer   → solo lee
     tecnico, reportero → de piso, acotados a Reportes/Levantamientos (y
                          Pólizas/Cotizaciones/Activos de solo lectura para
                          tecnico) — ver el bloque de cada colección
     control_activos → de piso, acotado a /activos nada más (puede leer,
                          crear y editar; borrar sigue siendo de Admin) —
                          ver el bloque de /activos
     cliente  → portal externo, no es personal de Forguard: ve nada más su
                propia póliza (sin costo interno), sus cotizaciones (ídem) y
                sus reportes — todo acotado por clienteId. Se auto-registra
                pero nace bloqueada; Owner/Admin la vincula y aprueba desde
                Admin → Usuarios. Ver esCliente()/miClienteId() más abajo.
   =========================================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    /* Tiene acceso quien está autenticado, tiene ficha de usuario y no está bloqueado. */
    function conAcceso() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }
    function rol() { return perfil().rol; }
    function esOwner()   { return conAcceso() && rol() == 'owner'; }
    function esAdmin()   { return conAcceso() && rol() in ['owner', 'admin']; }
    function puedeEditar() { return conAcceso() && rol() in ['owner', 'admin', 'analyst']; }

    /* --- Portal de clientes (agregado 03-sep-2026) ---
       `cliente` es la cuenta de alguien que NO trabaja en Forguard: el
       dueño/encargado de un cliente, viendo su propia información desde
       afuera. Nunca es "personal de piso acotado" como tecnico/reportero
       (esos sí son de Forguard) — por eso casi ninguna regla de abajo lo
       deja pasar por conAcceso() a secas: cada colección decide explícito
       si un cliente entra, y si entra, siempre acotado a lo suyo
       (miClienteId()). Lo que faltó marcar explícitamente queda cerrado
       por el candado general del final del archivo. */
    function esCliente()  { return conAcceso() && rol() == 'cliente'; }
    function miClienteId() { return perfil().clienteId; }

    /* --- Formulario público de reportes (agregado 11-sep-2026; pasó de un
       link por cliente a uno solo general el 12-sep-2026) ---
       ¿Este create de /reportes viene del formulario sin sesión, con un
       link válido? request.auth != null incluye tanto cuentas normales como
       Firebase Auth anónimo (accounts:signUp sin correo) — la firma real de
       "es un link" es que el propio documento declare su origen Y un token
       que apunte a un link que de verdad existe y sigue activo.

       Como ahora es UN SOLO link para toda la empresa (ya no trae guardado
       a qué cliente pertenece, ver abrirGestionLinkGeneralReportes()), aquí
       ya no se compara el clienteId del reporte contra el del link —se
       valida en su lugar que el clienteId/sitioId que la persona ELIGIÓ en
       el formulario (del directorio público, ver directorio_reportes_*
       más abajo) sean de verdad un cliente y un sitio que existen, y que el
       sitio sea DE ESE cliente. Las demás condiciones son el mismo candado
       que ya tiene /reportes contra un Analyst con más permiso del que
       debería: nadie entra aquí con un reporte que ya venga "resuelto",
       asignado a un técnico, o ligado a una cotización — eso es trabajo de
       piso, nunca de quien lo levanta desde la calle. */
    /* Sin variable intermedia a propósito: cada cláusula del && solo se
       evalúa si la anterior ya pasó (mismo orden de cortocircuito que el
       resto de este archivo), así que ningún get()/exists() de aquí corre
       para un create interno normal (donde enlacePublicoToken siempre es
       '', puesto por normalizarReporte()) ni para un token vacío o
       inexistente: la cláusula exists() del link ya cortó antes de llegar
       ahí. */
    function esCreatePublicoReporte() {
      return request.auth != null
        && request.resource.data.origenPublico == true
        && request.resource.data.enlacePublicoToken is string
        && request.resource.data.enlacePublicoToken != ''
        && exists(/databases/$(database)/documents/enlaces_publicos_reportes/$(request.resource.data.enlacePublicoToken))
        && get(/databases/$(database)/documents/enlaces_publicos_reportes/$(request.resource.data.enlacePublicoToken)).data.activo == true
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId))
        && (request.resource.data.get('sitioId', '') == ''
            || (exists(/databases/$(database)/documents/sitios/$(request.resource.data.sitioId))
                && get(/databases/$(database)/documents/sitios/$(request.resource.data.sitioId)).data.clienteId == request.resource.data.clienteId))
        && request.resource.data.estatus == 'abierto'
        && request.resource.data.tecnicos.size() == 0
        && request.resource.data.get('cotizacionId', '') == ''
        && request.resource.data.get('fechaCierre', '') == '';
    }

    /* --- Información del tablero --- */
    /* --- Clientes ---
       Crear y corregir es el trabajo del día: lo hace cualquiera que pueda
       editar. BORRAR es de Admin para arriba (decidido el 19-ago-2026): un
       cliente se lleva de golpe sus sitios con su historial de pagos y sus OC, y
       —como la colección de clientes es UNA sola para los dos módulos— también
       deja huérfana su póliza de mantenimiento. No hay deshacer.

       preciosGrupo (agregado 04-sep-2026, ver modalPreciosGrupo en index.html)
       se congela para quien no es Admin, mismo criterio que `encargado` en
       /sitios: es un precio, y las decisiones de precio son de Admin para
       arriba en todo el tablero (misma razón que /catalogo solo lo escribe
       esAdmin()). Con get() en las dos puntas por la misma lección del
       descuento — un cliente de antes de este campo no lo trae guardado, y
       leerlo con punto sería un error que rechaza también la corrección más
       inocente que un Analyst haga al resto del cliente. */
    match /clientes/{id} {
      /* Un cliente lee SU PROPIO documento (el id de este documento ES su
         clienteId) — nunca el catálogo completo de clientes de Forguard. */
      allow read:   if conAcceso() && (!esCliente() || id == miClienteId());
      allow create: if esAdmin()
                    || (puedeEditar() && request.resource.data.get('preciosGrupo', {}) == {});
      allow update: if esAdmin()
                    || (puedeEditar()
                        && request.resource.data.get('preciosGrupo', {}) == resource.data.get('preciosGrupo', {}));
      allow delete: if esAdmin();
    }
    /* --- Sitios ---
       El encargado —quién de Forguard lleva la cuenta— lo asigna solo un Admin.
       Ese candado vivía únicamente en la interfaz: con su token, un Analyst
       podía reasignarse sitios por REST y el servidor lo aceptaba. Ahora el
       campo está congelado para quien no es Admin, con get() en las dos puntas
       por la lección del descuento: los sitios viejos pueden no traer el campo,
       y un campo ausente leído con punto es un ERROR que rechaza también lo
       legítimo. Crear exige encargado vacío: nadie se asigna al capturar. */
    match /sitios/{id} {
      /* Mismo criterio que /clientes: un cliente solo ve sus propios sitios
         (donde tiene su Forpass/equipo), nunca el resto de la cartera. */
      allow read:  if conAcceso() && (!esCliente() || resource.data.clienteId == miClienteId());
      allow create: if esAdmin()
                    || (puedeEditar() && request.resource.data.get('encargado', '') == '');
      allow update: if esAdmin()
                    || (puedeEditar()
                        && request.resource.data.get('encargado', '') == resource.data.get('encargado', ''));
      /* Igual que el cliente: borrar un sitio se lleva su historial de pagos y
         sus órdenes de compra. Capturar y corregir, cualquiera; eliminar, Admin. */
      allow delete: if esAdmin();
    }

    /* --- Cotizaciones de servicio ---
       Tercer módulo (mantenimiento correctivo/preventivo/etc. cotizado por
       trabajo, no por contrato anual). A diferencia de las pólizas, aquí NO
       hay congelado de precios por regla: el margen y la instalación son
       editables por cotización a propósito (decisión de Victor,
       21-ago-2026), así que no hay un valor "correcto" que proteger contra
       quien sí tiene permiso de editar. Mismo candado que sitios: cualquiera
       que edite captura y corrige, solo Admin borra. */
    match /cotizaciones/{id} {
      /* Un cliente JAMÁS lee esta colección: trae precioCosto y margen tal
         cual. Lo suyo vive en /cotizaciones_cliente, una copia reducida sin
         esos campos (ver datosClienteCotizacion() en index.html) — así el
         costo interno ni siquiera viaja por la conexión hacia su sesión. */
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }
    /* --- Copia para el portal de clientes, sin costo interno ni margen ---
       La escribe la propia app (guardarCotizacion(), con el mismo permiso de
       quien puede editar cotizaciones) cada vez que se guarda una, EXCEPTO
       mientras sigue en 'borrador' (nunca se le compartió a nadie). El
       cliente la lee, acotada a la suya — nunca la de otro cliente. */
    match /cotizaciones_cliente/{id} {
      allow read:   if conAcceso() && (!esCliente() || resource.data.clienteId == miClienteId());
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Servicios Operativos (agregado 23-sep-2026) ---
       Segundo pilar del Framework de Proforma: Limpieza (trabajo suelto),
       Fumigación y Transporte de personal (contratos recurrentes, un solo
       renglón cada uno). Ni sensible como /nomina ni con una copia aparte
       para el portal de clientes (no se pidió eso todavía) — mismo candado
       exacto que /cotizaciones: cualquiera con acceso interno lo lee. */
    match /serviciosOperativos/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Reportes (tickets) ---
       Cuarto módulo: el reporte de una falla, que puede levantar CUALQUIERA
       con acceso al tablero — a propósito MÁS permisivo que `puedeEditar()`.
       Un Viewer no toca clientes, sitios ni cotizaciones, pero si ve un
       equipo dañado tiene que poder avisar y darle seguimiento (subir
       evidencia, marcarlo en proceso o resuelto) sin que un Admin tenga que
       levantarlo por él. Es el mismo espíritu que ya tienen /cotizaciones y
       /bitacora: captura y corrige, cualquiera con acceso; borrar, solo
       Admin — el historial de un reporte (con sus fotos) no se recupera. */
    match /reportes/{id} {
      /* Un reporte no trae ningún costo (es bitácora de campo: qué se
         encontró, qué se hizo, fotos), así que sí se puede leer tal cual —
         acotado a los suyos. Pero SOLO leer: el portal de clientes es de
         consulta, un cliente no levanta ni cierra tickets. */
      allow read:   if conAcceso() && (!esCliente() || resource.data.clienteId == miClienteId());
      /* create tiene DOS puertas: la de siempre (cualquier cuenta interna
         que no sea cliente) y la del formulario público sin sesión (link
         con QR, ver enlaces_publicos_reportes/ más abajo y
         arrancarFormularioPublicoReportesSiAplica() en index.html) —
         alguien sin cuenta, autenticado solo con Firebase Auth ANÓNIMO. La
         segunda puerta exige que el reporte traiga la marca de su origen Y
         el token de un link activo Y que declare el MISMO clienteId que ese
         link — así nadie con un link de un cliente puede levantar un
         reporte a nombre de otro, ni fingir que el reporte ya viene
         resuelto o ligado a una cotización. */
      allow create: if (conAcceso() && !esCliente()) || esCreatePublicoReporte();
      allow update: if conAcceso() && !esCliente();
      allow delete: if esAdmin();
    }
    /* --- Link público para levantar un reporte sin sesión (agregado
           11-sep-2026; un solo link general en vez de uno por cliente
           desde el 12-sep-2026) ---
       UN documento fijo, id 'general' (ver abrirGestionLinkGeneralReportes()
       en index.html): quien tiene el link puede leer ESE documento por su
       id (get) para saber si sigue activo, pero jamás listar la colección
       (list) — es la misma idea de siempre aunque ahora el id ya no sea un
       secreto largo, porque el link está pensado para compartirse
       ampliamente. Administrarlo (generarlo, activarlo, desactivarlo) es
       trabajo de Admin/Owner, igual que cualquier otro dato de
       configuración del tablero. */
    match /enlaces_publicos_reportes/{token} {
      allow get:  if request.auth != null;
      allow list: if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }
    /* --- Directorio público de clientes/sitios (agregado 12-sep-2026) ---
       El formulario del link general necesita que quien lo abre pueda
       buscar SU cliente y SU sitio en una lista — pero jamás debe poder
       leer /clientes ni /sitios completos (traen contacto, notas, campos
       personalizados, mensualidad…). Estas dos colecciones son la copia
       mínima —solo el nombre, y en sitios también a qué cliente pertenece—
       que guardarCliente()/guardarSitio() actualizan cada vez que se
       guarda el original (mismo espíritu que polizas_cliente/
       cotizaciones_cliente, nomás que aquí CUALQUIERA autenticado —incluido
       el link general, con Firebase Auth anónimo— puede leerla: es
       información pública a propósito, un directorio para poder elegir,
       no un dato que haya que esconder de nadie de la empresa. */
    match /directorio_reportes_clientes/{id} {
      allow read: if request.auth != null;
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }
    match /directorio_reportes_sitios/{id} {
      allow read: if request.auth != null;
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Notificaciones (agregado 12-sep-2026) ---
       El buzón por cuenta que llenan crearNotificacion()/
       notificarInteresadosReporte() en index.html: "se te asignó un
       reporte", "se resolvió", "hay un comentario nuevo". Cada documento
       es de UN destinatario (destinatarioUid) — nadie más que esa cuenta
       puede leerlo, ni siquiera Admin desde aquí (si algún día hace falta
       un panel de todas las notificaciones, sería su propia excepción
       explícita, no un descuido de esta regla). Solo se puede tocar el
       campo `leida` al marcarla vista — nada más se vuelve a escribir un
       aviso ya mandado. Crear uno es tan abierto como crear un reporte
       (conAcceso() && !esCliente()): cualquier acción interna que dispare
       un aviso —asignar, resolver, comentar— lo hace con el mismo permiso
       con el que ya toca /reportes. */
    match /notificaciones/{id} {
      allow read: if conAcceso() && resource.data.destinatarioUid == request.auth.uid;
      allow create: if conAcceso() && !esCliente() && request.resource.data.destinatarioUid is string;
      allow update: if conAcceso() && resource.data.destinatarioUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
      allow delete: if esAdmin();
    }

    /* --- Pendientes personales (agregado 23-sep-2026, pedido de Victor) ---
       La libreta de recordatorios de "Mis pendientes" (ver pintarPendientes()
       en index.html): texto libre, propio de CADA cuenta — a diferencia de
       /notificaciones (que ni Admin puede borrar, son un aviso del sistema),
       aquí sí puede su dueño editar y borrar lo suyo con libertad, porque es
       su propia libreta, no un aviso que alguien más mandó. Ni siquiera
       Admin puede leer la de otra cuenta desde aquí — si algún día hace
       falta un tablero de equipo, sería su propia colección aparte, no una
       excepción a esta. */
    match /pendientes/{id} {
      allow read: if conAcceso() && resource.data.usuarioUid == request.auth.uid;
      allow create: if conAcceso() && !esCliente() && request.resource.data.usuarioUid == request.auth.uid;
      allow update, delete: if conAcceso() && resource.data.usuarioUid == request.auth.uid;
    }

    /* --- Levantamientos (recorridos de sitio) ---
       Séptimo módulo: el registro de una visita completa, con varios
       hallazgos (correctivos o preventivos) dentro. A propósito "para todos
       los perfiles" — MÁS abierto todavía que /reportes: ahí un Viewer
       levanta el ticket pero no lo gestiona; aquí cualquiera con acceso
       levanta el recorrido Y da seguimiento a sus hallazgos por igual. Es un
       registro de campo, no un documento de precios. Borrar, solo Admin,
       mismo criterio que el resto del tablero. */
    match /levantamientos/{id} {
      /* No forma parte de lo que pidió el portal de clientes (su póliza, sus
         cotizaciones, sus reportes) — cerrado por completo para ese rol. */
      allow read:   if conAcceso() && !esCliente();
      allow create: if conAcceso() && !esCliente();
      allow update: if conAcceso() && !esCliente();
      allow delete: if esAdmin();
    }

    /* --- Imagen / Aperturas (proyectos de remodelación, apertura o cambio
           de imagen) ---
       Octavo módulo. Capturar y corregir sigue siendo de quien ya puede
       editar precios — son costos y proyectos comerciales, algunos todavía
       de un prospecto que ni siquiera es cliente formal (decisión de
       Victor, 27-ago-2026); borrar, solo Admin. LEER, en cambio, se abrió
       a cualquier cuenta interna (10-sep-2026): el perfil "Viewer" —ve
       todo, no edita nada— ahora también ve este módulo, mismo candado que
       ya usan /cotizaciones y /polizas (conAcceso() && !esCliente(): el
       portal de clientes nunca toca esta colección, tiene la suya). */
    match /proyectosImagen/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Servicios Extras (módulo viejo, fusionado con Cotizaciones el
           28-ago-2026 — ver ETAPAS_TABLERO_COTIZACION en index.html) ---
       Ya no se escribe desde la página: todo lo nuevo se captura como
       Cotización. Se deja SOLO lectura, y nada más para que
       migrarServiciosExtrasACotizaciones() pueda recoger, la primera vez que
       alguien se conecta, cualquier registro que ya se hubiera subido antes
       de la fusión. Cuando ya no quede nada ahí, este bloque se puede quitar. */
    match /serviciosExtras/{id} {
      allow read: if puedeEditar();
      allow write: if false;
    }

    /* --- Pólizas de mantenimiento preventivo ---
       La cotización y la póliza activa son el MISMO documento en distintos
       momentos, separados por su campo 'estatus':

         cotizacion → enviada → activa
                          ↘ perdida        (el cliente no la tomó)
                             activa → cancelada

       Aquí sí hay reglas por campo, y no por gusto: el precio con el que se
       cerró una póliza NO se puede tocar después. Sin esto el congelado sería
       una convención de la interfaz, y una convención no es un candado.

       Quién puede qué:
         · Todos con acceso    → leer
         · Analyst  → capturar y mover cotizaciones entre 'cotizacion' y
                      'enviada'. Sobre una póliza ya cerrada puede seguir
                      capturando cobranza y servicios ejecutados, pero NO puede
                      cambiar el estatus ni tocar las partidas.
         · Owner/Admin → todo, incluido cerrar, reabrir y corregir precios.

       Las tres cláusulas del update, en orden:
         1. Admin y Owner pasan siempre.
         2. Mientras la póliza entra Y sale en 'cotizacion' o 'enviada', se
            edita libre. Exigir las dos puntas es lo que impide cerrarla.
         3. Para cualquier otro estatus: se puede guardar SI el estatus no
            cambió Y las partidas salieron idénticas a como entraron.

       Por qué la cláusula 3 compara también el DESCUENTO: es un precio. Vive al
       nivel de la póliza y no dentro de `partidas`, así que comparando solo
       partidas un analyst podía bajarle 30% a una póliza ya cerrada sin tocar un
       solo renglón — pasaba la cláusula 3 y nadie se enteraba. Congelar los
       precios sin congelar el descuento es no congelar nada.

       Por qué la cláusula 3 compara también el estatus y no solo las partidas:
       comparando solo partidas, el candado se brincaba en dos pasos —el analyst
       pasaba 'activa' a 'cotizacion' dejando partidas igual (le pasaba la 3), y
       ya en 'cotizacion' la 2 le dejaba editar precios a gusto.

       Por qué la cláusula 3 congela también la VIGENCIA, la FACTURACIÓN y la
       FECHA DE CIERRE, medido el 18-ago-2026 con un Analyst real: ninguna de las
       tres es un precio, pero las tres son el acuerdo. `fechaInicio` manda el
       calendario —los meses de servicio son desfases desde ahí— así que moverla
       corre TODOS los servicios de TODOS los renglones a la vez, sin error y sin
       aviso: es la misma firma del bug que ya costó una vez. `facturacion`
       convierte doce cobros en uno. Y `fechaCierre` es la marca que la pantalla
       enseña como «precios congelados»: borrarla no descongela nada en el
       servidor, nada más hace que la interfaz mienta. Siguen libres `vendedor`,
       `sitioNombre`, `folio`, `notas` y las fechas de cotización y envío, que son
       correcciones de texto que un capturista hace con razón.

       Por qué el descuento se lee con get(campo, 0) y no con punto: Firestore NO
       trata un campo ausente como vacío — tirar de él es un ERROR de evaluación,
       y un error en una regla es un rechazo. El descuento se agregó el 14-ago y
       ninguna de las pólizas que ya existían lo tenía guardado, así que la
       cláusula 3 reventaba y un Analyst NO podía capturar una OC ni marcar un
       servicio en una póliza cerrada: 403 al reescribir el documento sin cambiar
       un solo valor. Medido el 18-ago-2026 con una cuenta Analyst real, que es la
       primera vez que estas cláusulas se ejercieron.

       La lección, para el siguiente campo que se agregue al nivel de la póliza:
       aquí un error de evaluación estorba a quien SÍ tiene permiso. En la cláusula
       2, en el create y en /usuarios un error deniega a quien no debía pasar, y
       ahí fallar cerrado es lo correcto — por eso solo esta cláusula necesita
       get(). Cualquier campo nuevo que se compare en la cláusula 3 va con get(). */
    match /polizas/{id} {
      /* Igual que /cotizaciones: un cliente JAMÁS lee esta colección (trae
         costoUnitario por renglón). Lo suyo vive en /polizas_cliente, una
         copia con ese campo en 0 (ver datosClientePoliza() en index.html). */
      allow read: if conAcceso() && !esCliente();

      /* Una póliza nace como cotización. Nadie estrena uno de estos ya cerrado:
         si no, el candado del update se brinca borrando y volviendo a crear. */
      allow create: if esAdmin()
                    || (puedeEditar()
                        && request.resource.data.estatus in ['cotizacion', 'enviada']);

      allow update: if esAdmin()
                    || (puedeEditar()
                        && resource.data.estatus in ['cotizacion', 'enviada']
                        && request.resource.data.estatus in ['cotizacion', 'enviada'])
                    || (puedeEditar()
                        && request.resource.data.estatus == resource.data.estatus
                        && request.resource.data.partidas == resource.data.partidas
                        && request.resource.data.get('descuento', 0) == resource.data.get('descuento', 0)
                        && request.resource.data.get('fechaInicio', '') == resource.data.get('fechaInicio', '')
                        && request.resource.data.get('facturacion', '') == resource.data.get('facturacion', '')
                        && request.resource.data.get('fechaCierre', '') == resource.data.get('fechaCierre', ''));

      /* Borrar una póliza cerrada es la forma más burda de saltarse todo lo de
         arriba, así que también es de Owner y Admin. */
      allow delete: if esAdmin();
    }
    /* --- Copia para el portal de clientes, sin costo interno ---
       La escribe la propia app (guardarPoliza(), mismo permiso que puede
       editar pólizas) cada vez que se guarda una que SÍ se le cobra al
       cliente (nunca las de cargoA:'interno' — ver datosClientePoliza()).
       Aquí no hace falta congelar precios por campo como en /polizas: esta
       copia nunca se edita a mano, solo la regenera el guardado de la real. */
    match /polizas_cliente/{id} {
      allow read:   if conAcceso() && (!esCliente() || resource.data.clienteId == miClienteId());
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Activos (control de activos, cliente + interno) ---
       Noveno módulo: junta en un solo catálogo el equipo instalado en casa
       del cliente y el activo propio de Forguard (herramienta, vehículo,
       laptop). Es dato patrimonial —qué se compró, en cuánto, quién lo
       tiene— así que no queda tan abierto como /reportes o
       /levantamientos (cualquiera con acceso). Pero sí lo puede tocar el
       rol `tecnico`, igual que un reporte o que "registrar servicio" de
       una póliza: es quien de verdad está frente al activo dándole
       mantenimiento o registrando que se movió de sitio. `control_activos`
       (agregado 17-sep-2026, pedido explícito de Victor) es justo lo
       opuesto de un rol "de piso" normal: en vez de estar acotado a TODO
       menos Activos, está acotado a Activos y NADA más — pero dentro de
       este módulo tiene el mismo alcance que puedeEditar() (alta, edición,
       asignación, mantenimiento). Borrar, solo Admin, como todo lo demás. */
    match /activos/{id} {
      /* Incluye el activo INTERNO de Forguard (herramienta, vehículo,
         laptop) revuelto en el mismo catálogo que el equipo instalado en
         casa del cliente — así que cerrado por completo para ese rol, ni
         siquiera acotado a lo suyo. No es parte de lo que pidió el portal. */
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar() || (conAcceso() && rol() in ['tecnico', 'control_activos']);
      allow update: if puedeEditar() || (conAcceso() && rol() in ['tecnico', 'control_activos']);
      allow delete: if esAdmin();
    }

    /* --- Proveedores (catálogo + sus gastos) ---
       Rastreo de lo que se les paga: nada de esto es del interés de un
       técnico o un reportero (a diferencia de /activos, aquí no hay razón
       para que alguien en campo lo toque), así que sin su excepción — solo
       quien puede editar en general. Borrar, Admin, como todo lo demás. */
    match /proveedores/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }
    match /gastosProveedor/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }
    match /refacciones/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }
    match /ordenesCompra/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create, update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Visitas (programación de rutas) ---
       Undécimo módulo: cuándo va cada técnico a qué sitio, armado desde lo
       que ya toca de póliza y los reportes abiertos. Mismo candado que
       /activos: administración de siempre, más el rol técnico —programa y
       ajusta su propia ruta sin depender de un Analyst—; cerrado por
       completo al portal de clientes, igual que /activos y /personal. */
    match /visitas/{id} {
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar() || (conAcceso() && rol() == 'tecnico');
      allow update: if puedeEditar() || (conAcceso() && rol() == 'tecnico');
      allow delete: if esAdmin();
    }

    /* --- Organigrama (directorio de personal) ---
       Décimo módulo: el directorio del personal de la empresa, tenga o no
       cuenta de acceso al tablero. A diferencia de /activos, aquí no hay
       excepción para `tecnico`: es dato de organización interna (puestos,
       a quién le reporta cada quien), no un registro de campo — mismo
       candado que /clientes y /cotizaciones. Cualquiera con acceso lo lee
       (es un directorio de consulta general); Analyst para arriba lo
       captura y corrige; borrar, solo Admin. */
    match /personal/{id} {
      /* Directorio interno de Forguard — no es de lo que pidió el portal de
         clientes, cerrado por completo. */
      allow read:   if conAcceso() && !esCliente();
      allow create: if puedeEditar();
      allow update: if puedeEditar();
      allow delete: if esAdmin();
    }

    /* --- Nómina (agregada 23-sep-2026, fase 1 del rediseño de Resultados) ---
       El gasto de nómina real, mes a mes — a diferencia de /personal (un
       directorio que cualquier cuenta interna puede consultar), esto es
       dinero, y de los rubros más sensibles del negocio: ni siquiera se
       puede LEER desde otro rol que no sea Owner/Admin, mismo candado que
       /bitacora. No es solo esconder la pestaña en index.html — el bloqueo
       real vive aquí. */
    match /nomina/{id} {
      allow read:   if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    /* --- Gastos generales (agregada 24-sep-2026, segunda fase del mismo
       rediseño de Resultados que /nomina) --- Gasolinas, trampas de grasa,
       extracciones, renders y demás gastos administrativos/corporativos:
       mismo candado exacto que /nomina, mismo motivo (dinero real del
       negocio, ni se puede LEER desde otro rol). */
    match /gastosGenerales/{id} {
      allow read:   if esAdmin();
      allow create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    /* --- Lista de precios de equipos ---
       Un solo documento, catalogo/lista, con el arreglo de equipos adentro. Va
       en un documento y no en uno por equipo para que sean 48 equipos por UNA
       lectura y no por 48: se lee en cada carga de página y se edita muy poco.

       Cualquiera con acceso la lee —el vendedor la necesita para cotizar— y solo
       Owner o Admin la cambia. Este candado SÍ es de servidor, no como el de
       cerrar pólizas: aquí basta el rol, sin comparar campos. --- */
    match /catalogo/{doc} {
      allow read:  if conAcceso() && !esCliente();
      allow write: if esAdmin();
    }

    /* --- Segmentos y parámetros personalizados ---
       Mismo molde que /catalogo: un documento único con un arreglo adentro.
       'segmentos' sustituye la constante ZONAS (sugerencias de zona al
       capturar un sitio) y 'parametros' guarda las definiciones de campos
       extra para clientes y sitios. Cualquiera con acceso los lee —los
       necesita para ver el formulario completo—, solo Owner o Admin los
       cambia. */
    match /segmentos/{doc} {
      allow read:  if conAcceso() && !esCliente();
      allow write: if esAdmin();
    }
    match /parametros/{doc} {
      allow read:  if conAcceso() && !esCliente();
      allow write: if esAdmin();
    }

    /* --- Historial: cualquiera con acceso lo escribe, solo admin lo lee,
           y nadie lo puede modificar ni borrar. --- */
    match /bitacora/{id} {
      allow read:   if esAdmin();
      allow create: if conAcceso() && !esCliente();
      allow update, delete: if false;
    }

    /* --- Cuentas y permisos ---
       · Cada quien puede leer su propia ficha (así la página sabe su rol).
       · Solo admin y owner ven todas.
       · Un admin NO puede crear, modificar ni borrar a un owner: eso es
         exclusivo del owner. Así nadie te puede degradar ni bloquear.
       · Cada quien puede actualizar únicamente su propio 'ultimoAcceso' y su
         propio 'telefono'. El teléfono se agregó porque las cotizaciones de
         póliza imprimen el celular del vendedor, y ese dato lo tiene que poder
         poner cada quien sin molestar a un administrador. Sigue sin poder
         tocarse 'rol' ni 'activo': nadie se puede ascender ni desbloquear. --- */
    match /usuarios/{uid} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);

      allow create: if esOwner()
                    || (esAdmin() && request.resource.data.rol != 'owner')
                    /* Autoservicio de clientes: cualquiera con una cuenta de
                       Firebase Auth (recién creada por accounts:signUp, ver
                       "Solicita tu acceso" en index.html) puede escribir SU
                       PROPIO perfil — pero nada más así, congelado en el
                       peor caso posible: nace 'cliente', bloqueada
                       (activo:false) y sin vincular a ningún clienteId. Ni
                       modificando el HTML de la página se puede lograr un
                       create con más permiso que este: el servidor lo
                       rechaza igual. Solo Owner/Admin puede después
                       aprobarla (activo:true + clienteId) desde Admin →
                       Usuarios. */
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.rol == 'cliente'
                        && request.resource.data.activo == false
                        && request.resource.data.clienteId == '');

      allow update: if esOwner()
                    || (esAdmin()
                        && resource.data.rol != 'owner'
                        && request.resource.data.rol != 'owner')
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoAcceso', 'telefono']));

      allow delete: if esOwner() || (esAdmin() && resource.data.rol != 'owner');
    }

    /* --- Marcas del sistema ---
       Aquí el respaldo automático deja la fecha de la última copia, para que el
       tablero pueda avisar si se quedó viejo. Cualquiera con acceso la lee;
       nadie la escribe desde la página. El robot del respaldo sí puede, porque
       entra con cuenta de servicio y esas se saltan estas reglas. --- */
    match /sistema/{doc} {
      allow read:  if conAcceso() && !esCliente();
      allow write: if false;
    }

    /* --- Marcas de sincronización incremental (agregada 21-sep-2026,
           veredicto de auditoría: hallazgo Escala 15 d-p "cada usuario baja
           la base entera cada 30 segundos" / Integración 10 d-p) ---
       UN documento, meta/sync, con un campo por colección: la hora del
       último cambio ahí. No es dato de negocio —nadie lee nada sensible
       aquí, como mucho "algo cambió en Refacciones" sin decir qué ni de
       quién—, es la señal que evita que cada pestaña vuelva a bajar las 17
       colecciones completas cada 30 segundos (ver coleccionesCambiadas()/
       marcarCambio() en index.html). Por eso no hay candado por campo como
       en el resto del archivo: cualquier cuenta interna con acceso puede
       leerlo y tocar cualquier campo al guardar algo suyo. Mientras esta
       regla no esté publicada, el refresco de 30s se cae de vuelta a bajar
       todo completo —el comportamiento de antes de este cambio, nunca uno
       peor—, así que esto se puede publicar cuando convenga sin prisa. */
    match /meta/{doc} {
      allow read, write: if conAcceso() && !esCliente();
    }

    /* Todo lo que no esté listado arriba queda cerrado. */
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
